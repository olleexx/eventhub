# ---- Core ----
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/eventhub?schema=public"
# 48+ random chars. Used to HMAC session/CSRF-adjacent values.
SESSION_SECRET=""
SESSION_TTL_HOURS=336
TRUST_PROXY=1

# ---- Bachs payments ----
# Secret API key. sk_sandbox_... selects https://sandbox-api.bachs.io, sk_live_... selects https://api.bachs.io
BACHS_API_KEY=""
# Signing secret of the webhook endpoint created in the Bachs developer portal
BACHS_WEBHOOK_SECRET=""
# Optional: previous secret accepted during rotation
BACHS_WEBHOOK_SECRET_PREVIOUS=""
# Set to "true" ONLY after you completed the sandbox procedure in docs/PAYMENTS.md
BACHS_LIVE_ENABLED=false

# ---- Commission defaults (admin can override in the dashboard) ----
PLATFORM_COMMISSION_PERCENT=5
PLATFORM_COMMISSION_FIXED_PER_TICKET=0

# ---- Email (SMTP) ----
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="EventHub <no-reply@example.com>"

# ---- Initial admin (used only by `npm run admin:create`) ----
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ---- Background jobs ----
# Bearer secret protecting POST /internal/cron/:task (for external schedulers)
CRON_SECRET=""
# Run the in-process worker inside the web process (ok on a persistent host, NOT serverless)
RUN_WORKER_IN_PROCESS=true

# ---- File storage ----
# local (dev only) | s3
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# ---- Tests ----
TEST_DATABASE_URL=""

# --- Payments driver ---------------------------------------------------------
# "bachs" (default) talks to Bachs. "mock" is for automated tests ONLY and is rejected when NODE_ENV=production.
PAYMENTS_DRIVER=bachs
# The following request paths could NOT be confirmed against docs.bachs.io (it was unreachable while this was written).
# Check them in the Bachs developer docs and override here if they differ. See docs/PAYMENTS.md.
BACHS_CHECKOUT_PATH=/v1/checkout-sessions
BACHS_VERIFY_PATH=/v1/checkout-sessions/{id}
BACHS_REFUND_PATH=/v1/refunds

# --- Branding ------------------------------------------------------------------
PLATFORM_NAME=EventHub
