{
  "name": "owambe-ticketing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-vendor event ticketing platform (Express + Prisma + PostgreSQL + Bachs payments)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node scripts/seed.js",
    "admin:create": "node scripts/create-admin.js",
    "bachs:check": "node scripts/bachs-sandbox-check.js",
    "worker": "node src/jobs/worker.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "check": "node scripts/syntax-check.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@prisma/client": "^6.2.0",
    "argon2": "^0.41.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "html5-qrcode": "^2.3.8",
    "multer": "^2.0.2",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.16.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.5",
    "slugify": "^1.6.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "prisma": "^6.2.0",
    "supertest": "^7.0.0"
  }
}
